# Notion Integration (server-side only — NEVER prefix with NEXT_PUBLIC_)
NOTION_API_KEY=
NOTION_DATABASE_ID=
# AI 웹 개발 기술 브리핑 ("AI Web Dev Researches" DB). Optional.
NOTION_BRIEFING_DATABASE_ID=
# Statuses published from the briefing DB (rows with "Blog Ready" checked are always published)
NOTION_BRIEFING_STATUSES=Researched,Published

# Site metadata (exposed to client)
NEXT_PUBLIC_SITE_URL=https://your-blog.example.com
NEXT_PUBLIC_SITE_NAME=Ian's Blog
NEXT_PUBLIC_AUTHOR_NAME=Ian
